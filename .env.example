# Copy to .env and edit. Every value here can also be set in the Settings tab, which
# takes precedence over this file.

# fixture = use the recorded slates in backend/fixtures (works with no network).
# live    = fetch from the real APIs.
DATA_MODE=fixture

# Underdog's endpoint is usually readable without credentials. Set this only if it
# starts returning 401/403 -- the Settings tab reports which providers are answering.
UNDERDOG_TOKEN=

# Free key from https://collegefootballdata.com -- required for the CFB tab in live mode.
CFBD_API_KEY=

# DATABASE_URL=sqlite:///./data/solver.db
# HTTP_TIMEOUT_SECONDS=20
# CACHE_TTL_SECONDS=300
