# Copy to .env and edit. Every value here can also be set in the Settings tab, which
# takes precedence over this file.

# fixture = use the recorded slates in backend/fixtures (works with no network).
# live    = fetch from the real APIs.
DATA_MODE=fixture

# Underdog's endpoint is usually readable without credentials. Set this only if it
# starts returning 401/403 -- the Settings tab reports which providers are answering.
UNDERDOG_TOKEN=

# Free key from https://collegefootballdata.com -- required for the CFB tab in live mode.
CFBD_API_KEY=

# DATABASE_URL=sqlite:///./data/solver.db
# HTTP_TIMEOUT_SECONDS=20
# CACHE_TTL_SECONDS=300

# ---------------------------------------------------------------- deployment
# Only needed when this runs somewhere other than your own machine. See DEPLOY.md.

# Postgres instead of SQLite. A managed `postgres://...` URL can be pasted verbatim.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Require a password on every request (HTTP Basic, any username). Leave blank for
# localhost. Set it for anything with a public URL.
# ACCESS_PASSWORD=

# Run the snapshot/grade schedule inside the web process, for deployments with no
# separate cron service. Leave false if cron jobs or launchd/systemd are doing it.
# ENABLE_SCHEDULER=false
# SCHEDULER_HOURS_UTC=16,20,23

# Extra browser origins allowed to call the API. Unnecessary when the frontend is
# served from the same host, which is the normal case.
# CORS_ORIGINS=https://your-app.onrender.com
